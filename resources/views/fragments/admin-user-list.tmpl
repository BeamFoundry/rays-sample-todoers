<div class="table-responsive">
    <table class="table table-hover">
        <thead>
            <tr>
                <th>ID</th>
                <th>Full Name</th>
                <th>Username</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {{range .Users}}
            <tr id="user-row-{{.ID}}">
                <td>{{.ID}}</td>
                <td>{{.FullName}}</td>
                <td>{{.Username}}</td>
                <td>
                    <button class="btn btn-sm btn-danger"
                            hx-delete="/admin/users/{{.ID}}"
                            hx-target="#user-row-{{.ID}}"
                            hx-swap="outerHTML"
                            hx-confirm="Are you sure you want to delete user '{{.Username}}'? This is permanent.">
                        Delete
                    </button>
                </td>
            </tr>
            {{end}}
        </tbody>
    </table>
</div>

<nav>
    <ul class="pagination justify-content-center">
        {{if .PrevPage}}
        <li class="page-item">
            <a class="page-link"
               href="#"
               hx-get="/admin/users?q={{.SearchQuery}}&page={{.PrevPage}}"
               hx-target="#user-list-container"
               hx-push-url="true">&laquo; Previous</a>
        </li>
        {{else}}
        <li class="page-item disabled">
            <span class="page-link">&laquo; Previous</span>
        </li>
        {{end}}

        <li class="page-item active" aria-current="page">
             <span class="page-link">Page {{.CurrentPage}}</span>
        </li>

        {{if .NextPage}}
        <li class="page-item">
            <a class="page-link"
               href="#"
               hx-get="/admin/users?q={{.SearchQuery}}&page={{.NextPage}}"
               hx-target="#user-list-container"
               hx-push-url="true">Next &raquo;</a>
        </li>
        {{else}}
        <li class="page-item disabled">
            <span class="page-link">Next &raquo;</span>
        </li>
        {{end}}
    </ul>
</nav>

