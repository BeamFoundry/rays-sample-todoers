{{template "views/layouts/main" .}}

{{define "title"}}{{ translate "login.html.title" }}{{end}}

{{define "content"}}
<div class="row justify-content-center">
    <div class="col-md-6 col-lg-4">
        <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
            <h2 class="mb-0">{{ translate "login.title" }}</h2>
            <div class="btn-group">
                <a href="?lang=en" class="btn btn-{{ if ne .Lang "en" }}outline-{{end}}primary" aria-current="page">EN</a>
                <a href="?lang=fr" class="btn btn-{{ if ne .Lang "fr" }}outline-{{end}}primary" aria-current="page">FR</a>
            </div>
        </div>
        {{- if .Error }}
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            {{ translate "login.error" }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
        {{- end }}
        <div class="card">
            <div class="card-body">
                <form action="{{.loginForm.Action}}" method="POST">
                    <div class="mb-3">
                        <label for="{{.loginForm.Username}}" class="form-label">{{translate "fields.login.username"}}</label>
                        <input type="text" id="username" name="{{.loginForm.Username}}"
                            class="form-control{{if and ( .Errors ) (index .Errors "username")}} is-invalid{{ end }}"
                            value="{{ .Form.Username }}">
                        {{- if and ( .Errors ) (index .Errors "username") }}
                        <div class="invalid-feedback">{{ index .Errors "username"}}</div>
                        {{- end }}
                    </div>
                    <div class="mb-3">
                        <label for="{{.loginForm.Password}}" class="form-label">{{translate "fields.login.password"}}</label>
                        <input type="password" id="password" name="{{.loginForm.Password }}"
                            class="form-control{{if and ( .Errors ) (index .Errors "password")}} is-invalid{{ end }}"
                            value="{{ .Form.Password }}">
                        {{- if and ( .Errors ) (index .Errors "password") }}
                        <div class="invalid-feedback">{{ index .Errors "password"}}</div>
                        {{- end }}
                    </div>
                    <div class="mb-3">
                        <label for="remember-me" class="form-label">Remember Me</label>
                        <input class="form-check-input" type="checkbox" id="remember-me" name="remember-me">
                    </div>
                    {{- if .Csrf }}
                    <input type="hidden" name="_csrf" value="{{ .Csrf }}">
                    {{- end }}
                    <button type="submit" class="btn btn-primary w-100">{{ translate "action.login"}}</button>
                </form>
                <div class="text-center mt-3">
                    <p>{{ translate "login.register" }} <a href="/register">{{ translate "login.register.action"}}</a></p>
                </div>
            </div>
        </div>
    </div>
</div>
{{end}}
